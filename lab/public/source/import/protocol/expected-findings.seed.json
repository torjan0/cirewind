  "prohibited_outcomes": [
    {
      "code": "downloaded-only-promoted-to-executed",
      "scope": "PUBLIC-SKIPPED",
      "state": "CONFIRMED_EXECUTED",
      "rationale": "The skipped marker lifecycle must never be called executed merely because preparation completed."
    },
    {
      "code": "attempts-or-matrix-jobs-merged-by-display-name",
      "scope": "ALL-SCENARIOS",
      "rationale": "The material identity is run_id + run_attempt + job_id, never a display name."
    },
    {
      "code": "head-sha-used-as-action-or-workflow-identity",
      "scope": "ALL-SCENARIOS",
      "rationale": "Trigger SHA, caller workflow SHA, called workflow SHA, and Action source SHA remain separate."
    },
    {
      "code": "current-a-clears-historical-b",
      "scope": "ALL-SCENARIOS",
      "rationale": "The restored current tag cannot downgrade exact historical B evidence."
    },
    {
      "code": "reusable-wrapper-relabeled-as-marker-b",
      "scope": "PUBLIC-REUSABLE",
      "rationale": "The called reusable-workflow commit and affected marker Action commit are different identities."
    },
    {
      "code": "temporal-order-promoted-to-causation",
      "scope": "ALL-SCENARIOS",
      "rationale": "A rerun or later resource event must not be attributed to an attacker or to marker B without direct causal evidence."
    },
    {
      "code": "credential-or-persistence-overclaim",
      "scope": "ALL-SCENARIOS",
      "rationale": "This lab supports no claim of secret access, cloud-role assumption, runner persistence, or deployment causation."
    },
    {
      "code": "runtime-result-without-stable-evidence-and-coverage",
      "scope": "ALL-SCENARIOS",
      "rationale": "Every public runtime result must retain stable evidence IDs and collection coverage."
    },
    {
      "code": "missing-evidence-promoted-to-no-match",
      "scope": "ALL-SCENARIOS",
      "state": "NO_MATCH_CONFIRMED",
      "rationale": "A missing required evidence class must produce UNKNOWN_EVIDENCE_GAP rather than a clean negative conclusion."
    }
  ]
