{{range .CountPairs}}<tr><th scope="row"><code>{{.Left.State}}</code></th><td>{{.Left.Count}}</td><th scope="row"><code>{{.Right.State}}</code></th><td>{{.Right.Count}}</td></tr>
{{end}}</tbody>
